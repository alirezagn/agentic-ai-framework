# Copy to .env and adjust. The CLI auto-loads ./.env (setdefault semantics:
# real environment variables always win). .env is gitignored.

# Backend: anthropic | ollama | openrouter
ORCHESTRATOR_LLM_PROVIDER=ollama

# Ollama server (native /api/chat, or append /v1 for OpenAI-compatible mode)
OLLAMA_BASE_URL=http://192.168.0.200:11434

# Model served by that Ollama instance (check: ollama list)
ORCHESTRATOR_LLM_MODEL=gemma4:12b

# API keys when using a cloud provider instead
# ANTHROPIC_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-...

# Optional tuning
# ORCHESTRATOR_CONTEXT_WINDOW_TOKENS=128000
# ORCHESTRATOR_LLM_MAX_TOKENS=8192   (output budget; 4096 default truncates data-heavy replies)
# ORCHESTRATOR_LLM_NUM_CTX=16384       (ollama context; server default often 4096 caps prompt+output)
# ORCHESTRATOR_LLM_TIMEOUT=300           (per-request seconds; default 120)
# ORCHESTRATOR_LOG_LEVEL=INFO

# --- Checkpoint integrity -------------------------------------------------
# Setting CHECKPOINT_SIGNING_KEY ENABLES signing: every checkpoint written from
# now on records signed=true plus an HMAC-SHA256 signature bound to the file
# contents, id, key id and timestamp. An unsigned snapshot is then reported as
# UNVERIFIABLE rather than silently accepted.
#
# Generate a key once (any long random string; this is not a password):
#     python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Keep it stable across machines that verify the same checkpoints, and rotate
# with ORCHESTRATOR_CHECKPOINT_KEY_ID below rather than by changing the secret
# in place — a rotated secret makes older snapshots report UNVERIFIABLE.
CHECKPOINT_SIGNING_KEY=

# Identifies which key signed a snapshot, so rotation is distinguishable from
# tampering. Change this when you rotate the secret above.
# ORCHESTRATOR_CHECKPOINT_KEY_ID=default

# Allow a snapshot whose signature cannot currently be checked (signed under a
# key that is not configured) to verify on checksums alone, with a warning.
# Never permits a TAMPERED snapshot to pass. Leave unset.
# CHECKPOINT_ALLOW_UNSIGNED=1
