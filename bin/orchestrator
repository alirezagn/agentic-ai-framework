#!/usr/bin/env python3
"""Executable entry point for the orchestrator runtime.

Usage::

    ./bin/orchestrator init my-project
    ./bin/orchestrator --project projects/my-project status
    ./bin/orchestrator --project projects/my-project tasks
    ./bin/orchestrator --project projects/my-project run
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from orchestrator.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
